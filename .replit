# Replit config — the student just clicks the big green Run button.
# Replit's system Python is read-only (Nix), so we install into a local
# virtual environment (.venv) instead of the system — then run the bot.
run = "test -d .venv || python -m venv .venv; . .venv/bin/activate && pip install -q -r requirements.txt && python bot.py"
entrypoint = "bot.py"
modules = ["python-3.11"]

[nix]
channel = "stable-24_05"

# Keys are NOT stored here. Add them in the Replit "Secrets" tool (lock icon):
#   TELEGRAM_TOKEN   and   GEMINI_API_KEY
