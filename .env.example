# ---- required ----
TELEGRAM_TOKEN=put-your-telegram-token-here
GEMINI_API_KEY=put-your-gemini-key-here

# ---- optional: email feature (leave blank to skip it) ----
# EASIEST: Resend (one API key, no app password). Get a key at resend.com.
RESEND_API_KEY=
# "From" address. To email ANYONE you must verify a domain in Resend and use it,
# e.g. bot@yourdomain.com. The tester onboarding@resend.dev only reaches your own inbox.
EMAIL_FROM=

# ALTERNATIVE to Resend: classic SMTP (Gmail/Yandex etc., needs an App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Safety: only allow sending to these addresses (comma-separated). Blank = allow any.
ALLOWED_EMAILS=
