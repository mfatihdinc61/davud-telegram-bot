# ---- required ----
TELEGRAM_TOKEN=put-your-telegram-token-here
GEMINI_API_KEY=put-your-gemini-key-here

# ---- optional: email feature (leave blank to skip it) ----
# For Gmail: turn on 2-Step Verification, then create an "App Password" and use it below.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
EMAIL_FROM=your-email@gmail.com
# Safety: only allow sending to these addresses (comma-separated). Blank = allow any.
ALLOWED_EMAILS=
